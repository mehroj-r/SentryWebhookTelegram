# ── App ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# false = long-poll Telegram instead of receiving its webhook (WEBHOOK_BASE_URL and
# WEBHOOK_SECRET_TOKEN are then optional; Sentry must still reach this server).
# USE_WEBHOOK=true
# 1-256 chars of A-Z a-z 0-9 _ -  (Telegram requirement)
WEBHOOK_SECRET_TOKEN=change_me_to_a_random_secret
# Must be https:// — Telegram only delivers webhooks over TLS
WEBHOOK_BASE_URL=https://your-domain.example.com
TG_WEBHOOK_PATH=/telegram/webhook
SENTRY_WEBHOOK_PATH=/sentry/webhook
# SQLite file path, or a PostgreSQL URL (postgresql://user:pass@host/db — needs the
# "postgres" extra: pip install .[postgres]).
DB_PATH=data.db
# Optional tuning
# MAX_BODY_BYTES=10485760
# QUEUE_MAX_SIZE=1000
# SEEN_REQUEST_TTL_DAYS=7
# Delete delivery-log and audit-log rows older than this (0 = keep forever).
# Threading and /retry_failed only reach back this far.
# LOG_RETENTION_DAYS=30
# BURST_WINDOW_SECONDS=600

# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAbbCCddEEff...
# Fallback chat when no route matches (use /chat_id in the bot to find it)
DEFAULT_CHAT_ID=-1001234567890
# Comma-separated or JSON list of users allowed to manage routes everywhere.
# Empty = per-chat: anyone in a private chat, Telegram group/channel admins in groups.
ADMIN_IDS=123456789,987654321
# Web admin page at /admin (disabled when empty). Use a long random string.
# ADMIN_TOKEN=
# Reject Sentry webhooks whose Sentry-Hook-Timestamp is older/newer than this many
# seconds (0 disables). The header isn't covered by Sentry's signature, so this only
# stops naive replays; Request-ID de-duplication still applies.
# REPLAY_WINDOW_SECONDS=300
# Prometheus /metrics is open unless this is set (then: Authorization: Bearer <token>).
# METRICS_TOKEN=

# ── Sentry ────────────────────────────────────────────────────────────────────
# Optional Web API access for Resolve / Ignore / Assign buttons on alerts.
# Internal integration token with Issue & Event "Read & Write".
# SENTRY_API_URL=https://sentry.io
# SENTRY_API_TOKEN=
# SENTRY_ORG_SLUG=my-org
# Several organisations: SENTRY_API_TOKENS=acme:token1,beta:token2
# Integration "Client Secret" — used to verify Sentry-Hook-Signature
SENTRY_CLIENT_SECRET=change_me
# Several organisations/integrations instead (or in addition):
# SENTRY_CLIENT_SECRETS=acme:secret1,beta:secret2
